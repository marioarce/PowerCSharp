<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet Package Metadata -->
    <PackageId>PowerCSharp.Operational.Abstractions</PackageId>
    <PackageVersion>$(PowerCSharpOperationalVersion)</PackageVersion>
    <Title>PowerCSharp Operational - Abstractions</Title>
    <Description>Framework-agnostic contracts and NoOp floors for PowerCSharp Operational: cross-cutting issue capture, diagnostics, and logging primitives usable in any application architecture. Targets netstandard2.0 and net8.0. No ASP.NET Core dependency, fully usable without DI or feature registration.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>PowerCSharp_NuGet_Icon.png</PackageIcon>
    <PackageTags>csharp;dotnet;operational;diagnostics;logging;cross-cutting;abstractions;clean-architecture</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <!-- Needed for JsonIgnore/JsonIgnoreCondition on the model types; System.Text.Json ships in the
         net8.0 shared framework but is not part of the netstandard2.0 contract (matches
         PowerCSharp.Helpers and PowerCSharp.Feature.Sanitization.Abstractions). Deliberately
         System.Text.Json, not Newtonsoft.Json — consistent with the rest of the repo. -->
    <PackageReference Include="System.Text.Json" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\docs\images\PowerCSharp_NuGet_Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
